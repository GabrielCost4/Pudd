{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "ecca2a8c-c47e-43d4-8777-6a2f6a2b63a8"
  },
  "newProjectRoot": "projects",
  "projects": {
    "WEB": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                "type": "anyComponentStyle",
                "maximumWarning": "6kB",
                "maximumError": "12kB"
              }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.main.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.hml.ts"
                }
              ]
            },
            "main": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                "type": "anyComponentStyle",
                "maximumWarning": "6kB",
                "maximumError": "12kB"
              }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.main.ts"
                }
              ]
            },
            "hml": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.hml.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "main"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "WEB:build:production"
            },
            "development": {
              "buildTarget": "WEB:build:development"
            },
            "hml": {
              "buildTarget": "WEB:build:hml"
            },
            "main": {
              "buildTarget": "WEB:build:main"
            }
          },
          "defaultConfiguration": "hml"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
